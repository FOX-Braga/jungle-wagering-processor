# Credenciais fictícias para o ambiente local.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
# INSTANCE_ID=api-local

POSTGRES_USER=jungle
POSTGRES_PASSWORD=jungle_dev
POSTGRES_DB=jungle
POSTGRES_PORT=5434
DATABASE_URL=postgresql://jungle:jungle_dev@127.0.0.1:5434/jungle
# DATABASE_URL_DOCKER=postgresql://jungle:jungle_dev@postgres:5432/jungle

SQS_PORT=4567
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=000000000000
AWS_SECRET_ACCESS_KEY=local-dev
SQS_ENDPOINT=http://127.0.0.1:4567
SQS_WAGER_QUEUE_URL=http://127.0.0.1:4567/000000000000/wager-transactions.fifo
SQS_WAGER_DLQ_URL=http://127.0.0.1:4567/000000000000/wager-transactions-dlq.fifo
# SQS_EVENT_QUEUE_URL=http://127.0.0.1:4567/000000000000/wager-events
SQS_POLL_WAIT_SECONDS=10
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_MAX_RECEIVE_COUNT=3
SQS_CONSUMER_CONCURRENCY=4
SQS_CONSUMER_NAME=wager-processor
OUTBOX_BATCH_SIZE=25
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_LEASE_SECONDS=30
REFERENCE_WORKER_BATCH_SIZE=25
REFERENCE_WORKER_INTERVAL_MS=1000
REFERENCE_MAX_ATTEMPTS=10
