                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const result = pm.response.json();",
                  "pm.test(\"Operação processada\", function () { pm.expect(result.status).to.eql(\"PROCESSED\"); });",
                  "pm.test(\"Saldo histórico em centavos exatos\", function () { pm.expect(result.balance.amount).to.eql(\"75.00\"); });",
