    {
      "name": "Wallets",
      "item": [
        {
          "name": "Criar carteira com 100.00 BRL",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"playerId\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.environment.unset(\"walletId\");",
                  "pm.environment.unset(\"transactionId\");",
                  "pm.environment.unset(\"externalTransactionId\");",
                  "pm.environment.unset(\"idempotencyKey\");",
                  "pm.environment.unset(\"referenceExternalTransactionId\");",
                  "pm.environment.unset(\"refundExternalTransactionId\");",
                  "pm.environment.unset(\"refundTransactionId\");",
                  "pm.environment.unset(\"temporaryExternalId\");",
                  "pm.environment.unset(\"temporaryKey\");",
                  "pm.environment.unset(\"nextCursor\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const wallet = pm.response.json();",
                  "pm.test(\"Saldo inicial\", function () { pm.expect(wallet.balance.amount).to.eql(\"100.00\"); });",
                  "pm.test(\"Versão inicial\", function () { pm.expect(wallet.version).to.eql(1); });",
                  "if (pm.response.code === 201) pm.environment.set(\"walletId\", wallet.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"{{playerId}}\",\n  \"initialBalance\": {\n    \"amount\": \"100.00\",\n    \"currency\": \"BRL\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/wallets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallets"
              ]
            }
          }
        },
