          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Saldo da carteira\", function () { pm.expect(pm.response.json().balance.amount).to.eql(\"100.00\"); });",
