{
  "name": "jungle-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "start:dev": "bun --env-file=.env.example --env-file=.env --watch src/main.ts",
    "start": "bun --env-file=.env.example --env-file=.env dist/src/main.js",
    "build": "bun node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "lint": "bun node_modules/eslint/bin/eslint.js .",
    "format:check": "bun node_modules/prettier/bin/prettier.cjs --check .",
    "format": "bun node_modules/prettier/bin/prettier.cjs --write .",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "test:unit": "bun --no-env-file test ./test/unit",
    "test:all": "bun run build && bun --env-file=.env.example --env-file=.env.test test ./test",
    "verify:evidence": "bun --no-env-file scripts/validation/phase9.ts verify",
    "test:soak": "bun --no-env-file scripts/validation/phase9.ts soak",
    "test:mutation": "bun --no-env-file scripts/validation/mutation.ts",
    "test:load": "bun run build && bun --env-file=.env.example --env-file=.env.test test/load/run.ts",
    "test:properties": "bun --no-env-file test ./test/properties",
    "test:integration": "bun --env-file=.env.example --env-file=.env.test test ./test/integration",
    "test:e2e": "bun --env-file=.env.example --env-file=.env.test test ./test/e2e",
    "test:http-contract": "bun --env-file=.env.example --env-file=.env.test test ./test/e2e -t OpenAPI",
    "test:distributed": "bun run build && bun --env-file=.env.example --env-file=.env.test test ./test/distributed",
    "demo:http": "bun --no-env-file scripts/demo/http.ts",
    "demo:financial": "bun --no-env-file scripts/demo/http.ts",
    "demo:complete": "bun --no-env-file scripts/validation/phase9.ts demo",
    "worker:consumer": "bun --env-file=.env.example --env-file=.env src/worker.main.ts consumer",
    "worker:outbox": "bun --env-file=.env.example --env-file=.env src/worker.main.ts outbox",
    "worker:references": "bun --env-file=.env.example --env-file=.env src/worker.main.ts references",
    "test:messaging": "bun run build && bun --env-file=.env.example --env-file=.env.test test ./test/messaging",
    "test:inbox": "bun run build && bun --env-file=.env.example --env-file=.env.test test ./test/messaging/consumer.test.ts -t HTTP",
    "test:dlq": "bun run build && bun --env-file=.env.example --env-file=.env.test test ./test/messaging/consumer.test.ts -t DLQ",
    "test:outbox": "bun --env-file=.env.example --env-file=.env.test test ./test/messaging/outbox.test.ts",
    "test:recovery": "bun run build && bun --env-file=.env.example --env-file=.env.test test ./test/recovery",
    "test:resilience": "bun run build && bun --env-file=.env.example --env-file=.env.test test ./test/recovery ./test/messaging/references.test.ts",
    "demo:resilience": "bun --env-file=.env.example --env-file=.env.test test ./test/recovery/resilience.test.ts -t resiliência",
    "demo:inbox": "docker compose --env-file .env.example up -d --wait --wait-timeout 90 postgres sqs && bun run test:inbox-recovery",
    "test:inbox-recovery": "bun --env-file=.env.example --env-file=.env.test test ./test/recovery/inbox-demo.test.ts",
    "queues:inspect": "bun --env-file=.env.example --env-file=.env scripts/bootstrap/queue-diagnostics.ts",
    "diagnostics:operations": "bun --env-file=.env.example --env-file=.env scripts/diagnostics/operations.ts",
    "audit:wallets": "bun --env-file=.env.example --env-file=.env scripts/audit/wallets.ts",
    "test:observability": "bun --no-env-file test ./test/observability",
    "test:audit": "bun --env-file=.env.example --env-file=.env.test test ./test/audit",
    "test:security": "bun --env-file=.env.example --env-file=.env.test test ./test/security",
    "test:concurrency": "bun --env-file=.env.example --env-file=.env.test test ./test/integration/application/concurrency.test.ts",
    "test:financial": "bun --env-file=.env.example --env-file=.env.test test ./test/integration/application/financial.test.ts",
    "test:atomicity": "bun --env-file=.env.example --env-file=.env.test test ./test/integration/application/atomicity.test.ts",
    "test:db:constraints": "bun --env-file=.env.example --env-file=.env.test test ./test/integration/persistence/constraints.test.ts",
    "test:db:transactions": "bun --env-file=.env.example --env-file=.env.test test ./test/integration/persistence/transactions.test.ts",
    "test:db:migrations": "bun --env-file=.env.example --env-file=.env.test test ./test/integration/persistence/migrations.test.ts",
    "db:migrate": "bun run migration:up",
    "db:migrate:down": "bun run migration:down",
    "db:migrate:status": "bun run migration:status",
    "infra:setup": "bun --env-file=.env.example --env-file=.env scripts/bootstrap/infra.ts setup",
    "infra:down": "docker compose --env-file .env.example --profile workers down",
    "doctor": "bun --env-file=.env.example --env-file=.env scripts/bootstrap/infra.ts doctor",
    "migration:up": "bun --env-file=.env.example --env-file=.env scripts/bootstrap/migrate.ts up",
    "migration:down": "bun --env-file=.env.example --env-file=.env scripts/bootstrap/migrate.ts down",
    "migration:status": "bun --env-file=.env.example --env-file=.env scripts/bootstrap/migrate.ts status"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1171.0",
    "@mikro-orm/core": "6.6.18",
    "@mikro-orm/migrations": "6.6.18",
    "@mikro-orm/nestjs": "6.1.2",
    "@mikro-orm/postgresql": "6.6.18",
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/swagger": "11.4.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "11.2.10",
    "@types/bun": "1.4.4",
    "ajv": "8.20.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.3",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  },
  "overrides": {
    "@rushstack/node-core-library": {
      "ajv": "8.20.0"
    }
  }
}
