{
  "name": "jungle-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "start:dev": "bun --env-file=.env.example --env-file=.env --watch src/main.ts",
    "start": "bun --env-file=.env.example --env-file=.env dist/src/main.js",
    "build": "bun node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "lint": "bun node_modules/eslint/bin/eslint.js .",
    "format:check": "bun node_modules/prettier/bin/prettier.cjs --check .",
    "format": "bun node_modules/prettier/bin/prettier.cjs --write .",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "test:unit": "bun --no-env-file test ./test/unit",
    "test:properties": "bun --no-env-file test ./test/properties",
    "test:integration": "bun --env-file=.env.example --env-file=.env.test test ./test/integration",
    "test:concurrency": "bun --env-file=.env.example --env-file=.env.test test ./test/integration/application/concurrency.test.ts",
    "test:financial": "bun --env-file=.env.example --env-file=.env.test test ./test/integration/application/financial.test.ts",
    "test:atomicity": "bun --env-file=.env.example --env-file=.env.test test ./test/integration/application/atomicity.test.ts",
    "test:db:constraints": "bun --env-file=.env.example --env-file=.env.test test ./test/integration/persistence/constraints.test.ts",
    "test:db:transactions": "bun --env-file=.env.example --env-file=.env.test test ./test/integration/persistence/transactions.test.ts",
    "test:db:migrations": "bun --env-file=.env.example --env-file=.env.test test ./test/integration/persistence/migrations.test.ts",
    "db:migrate": "bun run migration:up",
    "db:migrate:down": "bun run migration:down",
    "db:migrate:status": "bun run migration:status",
    "infra:setup": "bun --env-file=.env.example --env-file=.env scripts/bootstrap/infra.ts setup",
    "doctor": "bun --env-file=.env.example --env-file=.env scripts/bootstrap/infra.ts doctor",
    "migration:up": "bun --env-file=.env.example --env-file=.env scripts/bootstrap/migrate.ts up",
    "migration:down": "bun --env-file=.env.example --env-file=.env scripts/bootstrap/migrate.ts down",
    "migration:status": "bun --env-file=.env.example --env-file=.env scripts/bootstrap/migrate.ts status"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1171.0",
    "@mikro-orm/core": "6.6.18",
    "@mikro-orm/migrations": "6.6.18",
    "@mikro-orm/nestjs": "6.1.2",
    "@mikro-orm/postgresql": "6.6.18",
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/swagger": "11.4.8",
    "ajv": "8.13.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "11.2.10",
    "@types/bun": "1.4.4",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.3",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
